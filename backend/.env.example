# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://ccdc_user:changeme@localhost:5432/quanly_ccdc?schema=public"

JWT_SECRET="changeme-generate-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# Symmetric key used to encrypt VPN/FortiClient credentials at the
# application layer before they are written to network_access_credentials.
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY="changeme-32-byte-base64-key"

PORT=3000

# First IT_ADMIN account, created by `prisma db seed` (backend/prisma/seed.ts)
# only if the users table is empty. No default/fallback password - the seed
# script fails loudly if this is unset, on purpose (never auto-generate a
# password and print it to a log).
SEED_ADMIN_EMAIL="admin@quanly-ccdc.local"
SEED_ADMIN_PASSWORD="changeme-set-a-real-password-before-seeding"
