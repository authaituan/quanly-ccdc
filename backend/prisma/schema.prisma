// ==========================================================================
// Quan ly CCDC - IT Asset Management (ITAM)
// Prisma schema - Phase 1 scaffold
// Scope locked in 2026-08-10: see project memory "project-quanly-ccdc"
// Scale target: small deployment (~300-1000 assets, <20 admin users)
// ==========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------
// Taxonomy: IT Asset categories (Router, Switch, Server, PC, Camera, ...)
// Modeled as a table (not a hardcoded enum) so new categories can be added
// via admin UI without a code deploy.
// --------------------------------------------------------------------------
enum AssetCategoryGroup {
  NETWORK_INFRA // Router, Core/Access Switch, Firewall, Load Balancer, KVM Switch
  SERVER_STORAGE // Server (Rack/Blade), NAS, SAN, Rack Cabinet, PDU, UPS
  END_USER // PC Desktop, Laptop, Monitor, Printer, Scanner, IP Phone
  SURVEILLANCE_SECURITY // NVR/DVR, IP Camera, Access Control / Time Attendance
  AUXILIARY_CONSUMABLE // SFP, patch cord, converter, NIC, cable reel, spare parts
}

model AssetCategory {
  id        String             @id @default(cuid())
  group     AssetCategoryGroup
  code      String             @unique // e.g. CORE_SWITCH, PC_DESKTOP, IP_CAMERA
  name      String // Vietnamese display name, e.g. "Core Switch"
  isRackable Boolean           @default(false) // true => usually mounted in a rack (server, switch, PDU, UPS)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  assets ItAsset[]

  @@map("asset_categories")
}

// --------------------------------------------------------------------------
// Sites: every physical location that can hold assets - HQ, datacenter,
// district post office (buu cuc), branch office. Parent of RackLocation.
// Rationale: real inventory data (Book1.xlsx) shows 206 sites, most of
// which are branch post offices with no server room / no rack at all.
// --------------------------------------------------------------------------
model Site {
  id           String   @id @default(cuid())
  code         String   @unique // matches source "Mã MBC" style codes when imported
  name         String
  address      String?
  regionName   String? // matches "Tên BĐKV" - regional postal office grouping
  hasServerRoom Boolean @default(false)

  // Added 2026-08-10 for Book1.xlsx (Merge1) import - fields with no prior
  // home in this model. See backend/prisma/import-book1.ts.
  provinceCode     String? // Mã BĐT/TP
  provinceName     String? // Tên BĐT/TP
  regionCode       String? // Mã BĐKV
  wardCode         String? // Mã BĐX
  wardName         String? // Tên Bưu điện xã
  centralWardName  String? // Bưu điện xã trung tâm
  pointType        String? // Loại (GD3/VHX/GD1/VP/GD2/PH2/PH1)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  racks       RackCabinet[]
  assets      ItAsset[]
  departments Department[]

  @@map("sites")
}

// --------------------------------------------------------------------------
// Rack cabinets and U-slot placement - only relevant for sites with a
// server room / datacenter. Optional relation from ItAsset.
// --------------------------------------------------------------------------
model RackCabinet {
  id         String   @id @default(cuid())
  siteId     String
  name       String // e.g. "Rack A1"
  totalUSize Int      @default(42)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  site       Site           @relation(fields: [siteId], references: [id])
  placements RackPlacement[]

  @@unique([siteId, name])
  @@map("rack_cabinets")
}

model RackPlacement {
  id              String   @id @default(cuid())
  rackCabinetId   String
  assetId         String   @unique // one asset occupies one placement
  startUPosition  Int // e.g. 12 => "U12"
  uSizeOccupied   Int // e.g. 1, 2, 4
  pduOutletLabel  String? // "Tọa độ ổ điện PDU"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rackCabinet RackCabinet @relation(fields: [rackCabinetId], references: [id])
  asset       ItAsset    @relation(fields: [assetId], references: [id])

  @@map("rack_placements")
}

// --------------------------------------------------------------------------
// Core asset table
// --------------------------------------------------------------------------
enum OperatingStatus {
  IN_STOCK // Dự phòng trong kho
  PRODUCTION // Đang chạy
  MAINTENANCE // Đang bảo trì/Sửa chữa
  FAULTY // Lỗi/Báo hỏng
  DECOMMISSIONED // Thanh lý
}

enum OwnershipStatus {
  OWNED // Tài sản sở hữu
  LEASED // Thuê ngoài
  BORROWED_POC // Mượn POC/Demo
}

model ItAsset {
  id                  String            @id @default(cuid())
  assetTag            String            @unique // Ma_Thiet_Bi - QR code / asset tag
  name                String // Ten_Thiet_Bi
  categoryId          String
  siteId              String? // current physical site
  manufacturer        String? // Hang_San_Xuat
  model               String? // Model_Chi_Tiet
  serialNumber        String?           @unique // So_Serial
  specs               Json? // Thong_So_Ky_Thuat - free-form spec fields
  ipAddress           String? // Dia_Chi_IP
  macAddress          String? // Dia_Chi_MAC
  operatingStatus     OperatingStatus   @default(IN_STOCK)
  ownershipStatus     OwnershipStatus   @default(OWNED)
  warrantyExpiresAt   DateTime? // Ngay_Het_Han_Bao_Hanh
  supportExpiresAt    DateTime? // Ngay_Het_Han_SmartNet_License
  purchaseDate        DateTime?
  purchaseCost        Decimal?          @db.Decimal(14, 2)
  notes               String?
  currentUser         String? // Người sử dụng - added 2026-08-10 for Book1.xlsx import
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  category           AssetCategory        @relation(fields: [categoryId], references: [id])
  site                Site?                @relation(fields: [siteId], references: [id])
  rackPlacement       RackPlacement?
  assignments         EndUserAssignment[]
  maintenanceLogs     MaintenanceLog[]
  softwareLicenses    SoftwareLicenseLink[]
  accessCredential    NetworkAccessCredential?

  @@index([categoryId])
  @@index([siteId])
  @@map("it_assets")
}

// --------------------------------------------------------------------------
// End-user org structure (kept minimal - department + employee)
// --------------------------------------------------------------------------
model Department {
  id        String   @id @default(cuid())
  siteId    String?
  name      String
  createdAt DateTime @default(now())

  site      Site?               @relation(fields: [siteId], references: [id])
  employees Employee[]
  assignments EndUserAssignment[]

  @@map("departments")
}

model Employee {
  id           String   @id @default(cuid())
  fullName     String
  employeeCode String?  @unique
  departmentId String?
  email        String?
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  department  Department?         @relation(fields: [departmentId], references: [id])
  assignments EndUserAssignment[]

  @@map("employees")
}

// --------------------------------------------------------------------------
// End-user device assignment / handover (cấp phát - thu hồi)
// --------------------------------------------------------------------------
enum AssignmentStatus {
  ACTIVE
  RETURNED
  OFFBOARDING // decommission workflow in progress
}

model EndUserAssignment {
  id                  String            @id @default(cuid())
  assetId             String
  employeeId          String?
  departmentId        String?
  handoverDate        DateTime
  expectedReturnDate  DateTime?
  actualReturnDate    DateTime?
  status              AssignmentStatus  @default(ACTIVE)
  handoverChecklist   Json? // Tinh_Trang_Kiem_Tra: kèm sạc, dây HDMI, chuột...
  employeeConfirmedAt DateTime? // Xac_Nhan_Nhan_Su - digital confirmation timestamp
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  asset      ItAsset    @relation(fields: [assetId], references: [id])
  employee   Employee?   @relation(fields: [employeeId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([assetId])
  @@index([employeeId])
  @@map("enduser_assignments")
}

// --------------------------------------------------------------------------
// Maintenance / repair / upgrade history
// --------------------------------------------------------------------------
enum MaintenanceType {
  UPGRADE // Nâng cấp linh kiện
  REPAIR // Thay thế hỏng hóc
  PREVENTIVE // Bảo dưỡng định kỳ
  VENDOR_WARRANTY // Gửi bảo hành hãng
  REIMAGE // Cấu hình lại / Re-image
}

model MaintenanceLog {
  id               String          @id @default(cuid())
  assetId          String
  type             MaintenanceType
  description      String // Linh_Kien_Thay_The or general description
  supportProvider  String? // Don_Vi_Ho_Tro: nội bộ hoặc Cisco TAC, Dell Support...
  cost             Decimal?        @db.Decimal(14, 2)
  ticketRef        String? // Mã_Ticket_Lien_Quan
  performedAt      DateTime        @default(now())
  createdAt        DateTime        @default(now())

  asset ItAsset @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@map("it_maintenance_logs")
}

// --------------------------------------------------------------------------
// Software / license linked to an asset
// --------------------------------------------------------------------------
model SoftwareLicenseLink {
  id          String    @id @default(cuid())
  assetId     String
  softwareName String
  licenseKey  String? // stored encrypted at the application layer
  activatedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  asset ItAsset @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@map("software_licenses_link")
}

// --------------------------------------------------------------------------
// Network access credentials (VPN / FortiClient / management access) -
// kept in a SEPARATE table from ItAsset per user decision 2026-08-10:
// sensitive data, encrypted at rest, restricted to admin role only.
// --------------------------------------------------------------------------
model NetworkAccessCredential {
  id                    String   @id @default(cuid())
  assetId               String   @unique
  vpnUsername           String?
  vpnPasswordEncrypted  String? // encrypted at application layer (e.g. AES-GCM), never plain text
  fortiClientUsername   String?
  fortiClientPasswordEncrypted String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  asset ItAsset @relation(fields: [assetId], references: [id])

  @@map("network_access_credentials")
}

// --------------------------------------------------------------------------
// Auth / RBAC (minimal - Admin CNTT, Ke toan, Quan ly kho, Nhan vien)
// --------------------------------------------------------------------------
enum UserRole {
  IT_ADMIN
  ACCOUNTANT
  WAREHOUSE_MANAGER
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         UserRole @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
